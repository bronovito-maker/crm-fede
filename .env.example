# Runtime
NODE_ENV=development
PORT=3000
API_CACHE_TTL_MS=15000

# Baserow: token Database API. Non usare qui JWT utente o Builder.
BASEROW_BASE_URL=https://api.baserow.io
BASEROW_TOKEN=
BASEROW_TABLE_AGENTI_ID=
BASEROW_TABLE_CONTRATTI_ID=
# Legacy: mantenuta per compatibilita, non usata nel calcolo corrente dei nuovi contratti.
BASEROW_TABLE_COMPETENZE_ID=
BASEROW_TABLE_FORNITORI_ID=
BASEROW_TABLE_CUTOFF_FORNITORI_ID=
BASEROW_TABLE_CLIENTI_ID=
BASEROW_TABLE_FORNITURE_ID=

# Nomi campo Baserow; lasciare i default se lo schema usa questi nomi.
BASEROW_FIELD_CONTRATTI_AGENTE=agente
# Legacy, collegati a BASEROW_TABLE_COMPETENZE_ID.
BASEROW_FIELD_COMPETENZE_MESE=mese_competenza
BASEROW_FIELD_COMPETENZE_CUTOFF=data_cutoff
BASEROW_FIELD_FORNITORI_NOME=nome
BASEROW_FIELD_CUTOFF_FORNITORE=fornitore
BASEROW_FIELD_CUTOFF_MESE=mese_competenza
BASEROW_FIELD_CUTOFF_DATA=data_cutoff
BASEROW_FIELD_EX_FORNITORE=ex_fornitore

# Sessioni e password
SESSION_TTL_HOURS=12
SESSION_DB_PATH=
BCRYPT_ROUNDS=12

# Google Maps Places, opzionale
GOOGLE_MAPS_API_KEY=

# Cloudflare R2 o storage S3 compatibile, necessario per gli allegati
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Resend, opzionale. Senza questi valori la notifica email viene saltata.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFY_EMAIL=

# Solo per npm run baserow:setup-forniture.
# Usare un JWT Admin/Builder temporaneo e rimuoverlo appena terminato il setup.
BASEROW_JWT_TOKEN=
